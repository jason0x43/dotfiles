<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>local.environment</string>

    <key>RunAtLoad</key>
    <true/>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-c</string>
      <string>launchctl setenv CLAUDE_CONFIG_DIR "$HOME/.config/claude"</string>
    </array>

    <key>StandardErrorPath</key>
    <string>/tmp/local.environment/stderr.log</string>

    <key>StandardOutPath</key>
    <string>/tmp/local.environment/stdout.log</string>
  </dict>
</plist>
