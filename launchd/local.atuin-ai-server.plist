<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>local.atuin-ai-server</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-c</string>
      <string>/opt/homebrew/bin/docker rm -f atuin-ai-server &gt;/dev/null 2&gt;&amp;1; exec /opt/homebrew/bin/docker run --rm --name atuin-ai-server -p 127.0.0.1:62321:62321 -v "$HOME/.config/atuin-ai-server/config.toml:/etc/atuin-ai/config.toml:ro" ghcr.io/atuinsh/atuin-ai-server:latest</string>
    </array>

    <key>StandardErrorPath</key>
    <string>/tmp/local.atuin-ai-server/stderr.log</string>

    <key>StandardOutPath</key>
    <string>/tmp/local.atuin-ai-server/stdout.log</string>
  </dict>
</plist>
