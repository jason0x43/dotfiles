# Defines the helpers shared by the completions for the custom git commands in
# $DOTFILES/bin (_git-killbranch, _git-open, etc.). They're prefixed with
# __git_custom_ to avoid replacing the helpers in zsh's own _git completion.

__git_custom_ok() {
	if (( ${#pipestatus:#0} > 0 )); then
		_message 'not a git repository'
		return 1
	fi
	return 0
}

# Local and remote branch names, without the remote prefix
__git_custom_branches() {
	local expl
	local -a branch_names
	branch_names=(${(f)"$(_call_program branchrefs git for-each-ref --format='"%(refname)"' refs/{heads,remotes} | xargs basename | awk '!x[$0]++' | grep -v HEAD 2> /dev/null)"})
	__git_custom_ok || return
	_wanted branch-names expl branch-name compadd "$@" - $branch_names
}

# Branch names on the remote given in the previous word
__git_custom_remote_branches() {
	local expl remote=${words[CURRENT-1]}
	local -a branch_names
	branch_names=(${(f)"$(_call_program branchrefs git for-each-ref --format='"%(refname)"' refs/remotes/$remote | xargs basename | awk '!x[$0]++' | grep -v HEAD 2> /dev/null)"})
	__git_custom_ok || return
	_wanted branch-names expl branch-name compadd "$@" - $branch_names
}

__git_custom_remotes() {
	local expl
	local -a remote_names
	remote_names=(${(f)"$(_call_program remotenames git remote 2> /dev/null)"})
	__git_custom_ok || return
	_wanted remote-names expl remote-name compadd "$@" - $remote_names
}

__git_custom_files() {
	local expl
	local -a file_names
	file_names=(${(f)"$(_call_program filenames git ls-files 2> /dev/null)"})
	__git_custom_ok || return
	_wanted file-names expl file-name compadd "$@" - $file_names
}

# The 50 most recent commits
__git_custom_commits() {
	local expl
	local -a commit_ids
	commit_ids=(${(f)"$(_call_program commitrefs git rev-list HEAD --max-count=50 2> /dev/null)"})
	__git_custom_ok || return
	_wanted commit-ids expl commit-id compadd "$@" - $commit_ids
}
