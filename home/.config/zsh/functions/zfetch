# This code was originally from
# https://github.com/ninrod/dotfiles/boot/functions.zsh
#
# Avoid cd here; once zoxide and mise are loaded, every cd runs their hooks.

local Rst='\e[0m' Red='\e[31m' Yel='\e[33m' Blu='\e[34m'

typeset -Ag plugins

# Simplest dependency fetcher known to mankind
if [[ $1 == "update" ]]; then
  for name in ${(@k)plugins}; do
    if ! git -C $plugins[$name] symbolic-ref -q HEAD > /dev/null; then
      echo -e "Skipping ${Yel}${name}${Rst} (pinned to a ref)"
      continue
    fi
    echo -e "Updating ${Yel}${name}${Rst}..."
    git -C $plugins[$name] pull --quiet --recurse-submodules
  done
elif [[ $1 == "ls" ]]; then
  for name in ${(@k)plugins}; do
    echo -e "${name}: ${Yel}$plugins[$name]${Rst}"
  done
else
  # where the repo is going
  local dest="$1"
  # the short name of the repo (org/repo)
  local name="$2"

  # if the dest dir ends with /, append the name to it to get the real dest dir
  if [[ $dest == */ ]]; then
    dest=$dest$name
  else
    dest=$dest/$name
  fi

  if [[ ! -d $dest ]]; then
    local url=https://github.com/$name
    local ref=$3
    local -a depth=(--depth 1)
    [[ -n $ref ]] && depth=()
    echo -e "Missing plugin ${Yel}${name}${Rst}"
    echo -e "  Cloning from ${Blu}${url}${Rst}..."
    # Fail instead of prompting for credentials if the repo doesn't exist
    GIT_TERMINAL_PROMPT=0 git clone --quiet --recurse-submodules $depth $url $dest
    local err=$?
    if (( err )); then
      echo -e "  ${Red}[ERROR]${Rst} git clone errored: ${Red}${err}${Rst}. ${Yel}aborting...${Rst}"
      return $err
    fi

    if [[ -n $ref ]]; then
      git -C $dest checkout --quiet $ref
      echo -e "  Checked out ${ref}"
    else
      echo -e "  Checked out default branch"
    fi
  fi

  plugins[$name]=$dest
fi
